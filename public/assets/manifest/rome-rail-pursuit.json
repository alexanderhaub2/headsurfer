{
  "pack": "Rome Rail Pursuit",
  "style": "Original stylized-realistic Mediterranean city runner",
  "runtime": {
    "buildingSprites": [
      "assets/runtime/travertine-palazzo.webp",
      "assets/runtime/naples-balcony-house.webp"
    ],
    "stationSprite": "assets/runtime/volcanic-station-canopy.webp",
    "trainSprites": [
      "assets/runtime/silver-metro-car.webp",
      "assets/runtime/terracotta-commuter-car.webp"
    ],
    "pursuerSprites": [
      "assets/runtime/fedora-pursuer.webp",
      "assets/runtime/trenchcoat-pursuer.webp",
      "assets/runtime/floral-pursuer.webp"
    ],
    "railKit": {
      "note": "Authored GLBs for everything on the line; supersede the retired silver/terracotta train GLBs.",
      "track": {
        "file": "assets/models/kit/rail-track.glb",
        "parts": ["track:clean", "track:worn", "track:far"],
        "segmentLength": 6
      },
      "trains": {
        "file": "assets/models/kit/trains.glb",
        "passengerFamilies": ["metro", "regional", "littorina", "express"],
        "modules": ["cab", "bayD", "bayW", "bayJ", "tail"],
        "freight": ["freight:boxcar", "freight:boxcarShort", "freight:tank"],
        "running": ["bogie:passenger", "bogie:freight", "axle:freight"]
      },
      "obstacles": {
        "file": "assets/models/kit/track-obstacles.glb",
        "barriers": ["works", "travertine", "crates"],
        "gates": ["crossing", "column", "scaffold"]
      },
      "pickups": {
        "file": "assets/models/kit/pickups.glb",
        "coin": "aureus",
        "powers": ["multiplier (laurel wreath)", "magnet (horseshoe)", "shield (scutum)"]
      },
      "generator": "scripts/build-rome-rail-kit.mjs"
    },
    "music": "assets/audio/mediterranean-chase.mp3",
    "effects": [
      "assets/audio/lane-switch.mp3",
      "assets/audio/jump.mp3",
      "assets/audio/roll.mp3",
      "assets/audio/coin.mp3",
      "assets/audio/powerup.mp3",
      "assets/audio/near-miss.mp3",
      "assets/audio/collision.mp3"
    ]
  },
  "sourceModels": [
    "asset-sources/rome-rail-pursuit/models/travertine-palazzo.glb",
    "asset-sources/rome-rail-pursuit/models/naples-balcony-house.glb",
    "asset-sources/rome-rail-pursuit/models/volcanic-station-canopy.glb",
    "asset-sources/rome-rail-pursuit/models/terracotta-commuter-car.glb"
  ],
  "integration": {
    "renderer": "src/game/renderer.ts",
    "railKit": "src/game/trackKit.ts",
    "audio": "src/game/audio.ts",
    "controller": "src/game/controller.ts"
  }
}
